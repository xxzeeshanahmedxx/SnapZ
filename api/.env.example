# Copy to .env (git-ignored) and fill in. Used by ./deploy.sh to generate
# wrangler.toml, so no resource IDs ever land in the repo.

# from: wrangler d1 create snapz
D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
D1_DATABASE_NAME=snapz

# from: wrangler r2 bucket create snapz-photos
R2_BUCKET=snapz-photos

# optional: public R2 domain. Empty = images served via the Worker at /i/<key>
R2_PUBLIC_BASE=
